    ((2708916931/83886080000:ℝ)+(-6370590793/251658240000:ℝ)*w)*v^3 +
    ((7274185093/67108864000:ℝ)+(-5066441093/67108864000:ℝ)*w)*v^2 +
    ((-83564347671/838860800000:ℝ)+(289041843013/2516582400000:ℝ)*w)*v^1 +
    ((-508030459373/1677721600000:ℝ)+(401138785773/1677721600000:ℝ)*w)*v^0
lemma LR1Q_4_row3_nonneg (w v : ℝ) (hlo : 0 ≤ w-1414213/1000000) (hhi : 0 ≤ 1414214/1000000-w) (hv : 0 ≤ v) (hv1 : 0 ≤ 1-v) : 0 ≤ LR1Q_4_row3 w v := by
  have heq : LR1Q_4_row3 w v =
    ((59265226271391649/1677721600000000000:ℝ)+(401138785773/1677721600000:ℝ)*(w-1414213/1000000))*v^0*(1-v)^6 +
    ((69146072536246861/251658240000000000:ℝ)+(389929091497/251658240000:ℝ)*(w-1414213/1000000))*v^1*(1-v)^5 +
    ((212792946953897561/251658240000000000:ℝ)+(1028084035397/251658240000:ℝ)*(w-1414213/1000000))*v^2*(1-v)^4 +
    ((14026004989298153/10485760000000000:ℝ)+(58753791381/10485760000:ℝ)*(w-1414213/1000000))*v^3*(1-v)^3 +
    ((72638429074173961/62914560000000000:ℝ)+(264216998197/62914560000:ℝ)*(w-1414213/1000000))*v^4*(1-v)^2 +
    ((1618906581657097/3145728000000000:ℝ)+(5074562869/3145728000:ℝ)*(w-1414213/1000000))*v^5*(1-v)^1 +
    ((2377893284493361/26214400000000000:ℝ)+(6284871997/26214400000:ℝ)*(w-1414213/1000000))*v^6*(1-v)^0 := by unfold LR1Q_4_row3; ring
  rw [heq] <;> positivity

theorem LR1Q_leaf4 (u v : ℝ) (hu : u ∈ Set.Icc 0 1)
    (hv : v ∈ Set.Icc (1/2:ℝ) 1) : 0 ≤ YLR1Q u v-XLR1Q u+(Real.sqrt 2-1)*R (YLR1Q u v)+C1 (XLR1Q u)-2*Q ((XLR1Q u+YLR1Q u v)/2) := by
  have hs2 : (Real.sqrt (2:ℝ))^2 = 2 := Real.sq_sqrt (by norm_num)
  have hs := Real.sqrt_nonneg (2:ℝ)
  have hlo : 0 ≤ Real.sqrt (2:ℝ)-1414213/1000000 := by nlinarith
  have hhi : 0 ≤ 1414214/1000000-Real.sqrt (2:ℝ) := by nlinarith
  let U := (u-0)/1
  let V := (v-(1/2:ℝ))/(1/2:ℝ)
  have hU : 0 ≤ U := by dsimp [U]; linarith [hu.1]
  have hU1 : 0 ≤ 1-U := by dsimp [U]; linarith [hu.2]
  have hV : 0 ≤ V := by dsimp [V]; linarith [hv.1]
  have hV1 : 0 ≤ 1-V := by dsimp [V]; linarith [hv.2]
  have hr0 := LR1Q_4_row0_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr1 := LR1Q_4_row1_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr2 := LR1Q_4_row2_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr3 := LR1Q_4_row3_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have heq : YLR1Q u v-XLR1Q u+(Real.sqrt 2-1)*R (YLR1Q u v)+C1 (XLR1Q u)-2*Q ((XLR1Q u+YLR1Q u v)/2) =
    LR1Q_4_row0 (Real.sqrt 2) V*U^0*(1-U)^3 +
    LR1Q_4_row1 (Real.sqrt 2) V*U^1*(1-U)^2 +
    LR1Q_4_row2 (Real.sqrt 2) V*U^2*(1-U)^1 +
    LR1Q_4_row3 (Real.sqrt 2) V*U^3*(1-U)^0 := by
    dsimp [Q,R,C1,XLR1Q,YLR1Q,U,V,LR1Q_4_row0,LR1Q_4_row1,LR1Q_4_row2,LR1Q_4_row3]
    ring_nf <;> norm_num [hs2] <;> ring
  rw [heq] <;> positivity
end HammingCubeLR
