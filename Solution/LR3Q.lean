  have hV : 0 ≤ V := by dsimp [V]; linarith [hv.1]
  have hV1 : 0 ≤ 1-V := by dsimp [V]; linarith [hv.2]
  have hr0 := LR3Q_1_row0_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr1 := LR3Q_1_row1_nonneg (Real.sqrt 2) V hlo hhi hV hV1
