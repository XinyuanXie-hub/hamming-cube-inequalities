lemma normalized_certificate (s t : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    0 ≤ ((2+t)/4-(1+s)/4)^2 + (R ((2+t)/4))^2 -
      (2*Q (((1+s)/4+(2+t)/4)/2)-Q ((1+s)/4))^2 := by
  let w := Real.sqrt (2 : ℝ)
  have hw0 : 0 ≤ w := Real.sqrt_nonneg _
  have hw2 : w^2 = 2 := Real.sq_sqrt (by norm_num)
  have hwlo : (707/500 : ℝ) ≤ w := by nlinarith
  have hwhi : w ≤ (283/200 : ℝ) := by nlinarith
  have hs : 0 ≤ 1-s := by linarith
  have hr0 := row0_nonneg w t hwlo hwhi ht0 ht1
  have hr1 := row1_nonneg w t hwlo hwhi ht0 ht1
  have hr2 := row2_nonneg w t hwlo hwhi ht0 ht1
  have hr3 := row3_nonneg w t hwlo hwhi ht0 ht1
  have hr4 := row4_nonneg w t hwlo hwhi ht0 ht1
  have hr5 := row5_nonneg w t hwlo hwhi ht0 ht1
  have hr6 := row6_nonneg w t hwlo hwhi ht0 ht1
  have heq : ((2+t)/4-(1+s)/4)^2 + (R ((2+t)/4))^2 -
      (2*Q (((1+s)/4+(2+t)/4)/2)-Q ((1+s)/4))^2 =
    row0 w t * s^0 * (1-s)^6 +
    row1 w t * s^1 * (1-s)^5 +
    row2 w t * s^2 * (1-s)^4 +
    row3 w t * s^3 * (1-s)^3 +
    row4 w t * s^4 * (1-s)^2 +
    row5 w t * s^5 * (1-s)^1 +
    row6 w t * s^6 * (1-s)^0 := by
    dsimp [R,Q,w,row0,row1,row2,row3,row4,row5,row6]
    ring_nf
    norm_num [Real.sq_sqrt]
    ring
  rw [heq]
  positivity

theorem QRQ_squared (x y : ℝ) (hx : x ∈ Set.Icc (1/4) (1/2))
    (hy : y ∈ Set.Icc (1/2) (3/4)) :
    0 ≤ (y-x)^2 + (R y)^2 - (2*Q ((x+y)/2)-Q x)^2 := by
  have h := normalized_certificate (4*x-1) (4*y-2)
    (by linarith [hx.1]) (by linarith [hx.2])
    (by linarith [hy.1]) (by linarith [hy.2])
  have he1 : (1+(4*x-1))/4=x := by ring
  have he2 : (2+(4*y-2))/4=y := by ring
  simpa only [he1,he2] using h

theorem QRQ_two_point (x y : ℝ) (hx : x ∈ Set.Icc (1/4) (1/2))
    (hy : y ∈ Set.Icc (1/2) (3/4)) :
    2*Q ((x+y)/2) ≤ Real.sqrt ((y-x)^2+(R y)^2)+Q x := by
  have h := QRQ_squared x y hx hy
  have hs := Real.le_sqrt_of_sq_le (show (2*Q ((x+y)/2)-Q x)^2 ≤ (y-x)^2+(R y)^2 by linarith)
  linarith
end HammingCubePolynomial
