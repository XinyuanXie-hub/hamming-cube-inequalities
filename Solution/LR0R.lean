namespace HammingCubeLR
def XLR0R (u : ℝ) := (0+u)/16
def YLR0R (u v : ℝ) := let x := XLR0R u; 1-x+x*v

noncomputable def LR0R_0_row0 (w v : ℝ) : ℝ :=
    (0+0*w)*v^0
lemma LR0R_0_row0_nonneg (w v : ℝ) (hlo : 0 ≤ w-1414213/1000000) (hhi : 0 ≤ 1414214/1000000-w) (hv : 0 ≤ v) (hv1 : 0 ≤ 1-v) : 0 ≤ LR0R_0_row0 w v := by
  have heq : LR0R_0_row0 w v =
    0 := by unfold LR0R_0_row0; ring
  rw [heq] <;> positivity

