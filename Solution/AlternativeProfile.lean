import Mathlib

set_option maxHeartbeats 2000000

noncomputable section

namespace AlternativeProfile

noncomputable def Q (x : ℝ) : ℝ :=
  (2 / 3 : ℝ) * x * (1 - x) *
    (4 * Real.sqrt 2 - 3 + 4 * (3 - 2 * Real.sqrt 2) * x)

/-- Rational degree-six replacement for the Gaussian upper branch.
Its values at 1/2 and 1 are exactly 1/2 and 0. -/
def R (x : ℝ) : ℝ :=
  let z := 2 * x - 1
  1/2 + 2037*z/25000 - 9759*z^2/20000 + 123*z^3/1250 -
    471*z^4/1250 + 24189*z^5/50000 - 29891*z^6/100000

theorem R_half : R (1/2) = 1/2 := by norm_num [R]
theorem R_one : R 1 = 0 := by norm_num [R]

def diagonalCertificate (a c : ℝ) : ℝ :=
    (1) * (a) ^ 10 +
    ((-152292353 / 62500000 : ℝ)) * (a) ^ 9 * (c) ^ 1 +
    ((-9991017 / 2500000 : ℝ)) * (a) ^ 8 * (c) ^ 2 +
    ((417401499 / 125000000 : ℝ)) * (a) ^ 7 * (c) ^ 3 +
    ((1230032313 / 62500000 : ℝ)) * (a) ^ 6 * (c) ^ 4 +
    ((2894409837 / 250000000 : ℝ)) * (a) ^ 5 * (c) ^ 5 +
    ((-22023537 / 25000000 : ℝ)) * (a) ^ 4 * (c) ^ 6 +
    ((-74519073 / 62500000 : ℝ)) * (a) ^ 3 * (c) ^ 7 +
    ((746899209 / 500000000 : ℝ)) * (a) ^ 2 * (c) ^ 8 +
    ((84045917 / 125000000 : ℝ)) * (a) ^ 1 * (c) ^ 9 +
    ((241 / 10000 : ℝ)) * (c) ^ 10

