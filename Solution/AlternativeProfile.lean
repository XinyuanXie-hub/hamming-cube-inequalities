theorem R_two_point (x y : ℝ) (hx : (1/2 : ℝ) ≤ x)
    (hxy : x ≤ y) (hy : y ≤ 1) :
    2 * R ((x+y)/2) ≤ Real.sqrt ((y-x)^2+R y^2) + R x := by
  have h := R_two_point_squared x y hx hxy hy
  have hs := Real.le_sqrt_of_sq_le (show (2*R ((x+y)/2)-R x)^2 ≤
    (y-x)^2+R y^2 by linarith)
  linarith

/-- The upper polynomial is nonnegative on its full domain. -/
theorem R_nonneg (x : ℝ) (hx : (1/2 : ℝ) ≤ x) (h1 : x ≤ 1) : 0 ≤ R x := by
  let z := 2*x-1
  have hz : 0 ≤ z := by dsimp [z]; linarith
  have hz1 : 0 ≤ 1-z := by dsimp [z]; linarith
  have heq : R x =
    (50000 : ℝ) / 100000 * 1 * z^0 * (1-z)^6 +
    (51358 : ℝ) / 100000 * 6 * z^1 * (1-z)^5 +
    (49463 : ℝ) / 100000 * 15 * z^2 * (1-z)^4 +
    (44807 : ℝ) / 100000 * 20 * z^3 * (1-z)^3 +
    (35370 : ℝ) / 100000 * 15 * z^4 * (1-z)^2 +
    (24683 : ℝ) / 100000 * 6 * z^5 * (1-z)^1 := by
    dsimp [R, z]
    ring
  rw [heq]
  positivity

theorem QR_symmetry (x : ℝ) (hx : (1/4 : ℝ) ≤ x) (hh : x ≤ 1/2) :
    4*x*(1-x) ≤ Q x + R (1-x) := by
  let z := 4*x-1
  have hz : 0 ≤ z := by dsimp [z]; linarith
  have hz1 : 0 ≤ 1-z := by dsimp [z]; linarith
  have hh' : 0 ≤ 1/2-x := by linarith
  have hs : 0 ≤ Real.sqrt (2 : ℝ) := Real.sqrt_nonneg _
  have hs2 : (Real.sqrt (2 : ℝ))^2 = 2 := Real.sq_sqrt (by norm_num)
  have hlo : (7/5 : ℝ) ≤ Real.sqrt 2 := by nlinarith
  have h0 : 0 ≤ 1 * Real.sqrt 2 + ((-2125119/1600000:ℝ)) := by linarith
  have h1 : 0 ≤ (17/15:ℝ) * Real.sqrt 2 + ((-3046931/2000000:ℝ)) := by linarith
  have h2 : 0 ≤ (37/30:ℝ) * Real.sqrt 2 + ((-167447/100000:ℝ)) := by linarith
  have h3 : 0 ≤ (13/10:ℝ) * Real.sqrt 2 + ((-17773/10000:ℝ)) := by linarith
  have h4 : 0 ≤ (4/3:ℝ) * Real.sqrt 2 + ((-183463/100000:ℝ)) := by linarith
  have h5 : 0 ≤ (4/3:ℝ) * Real.sqrt 2 + ((-22963/12500:ℝ)) := by linarith
  have heq : Q x + R (1-x) - 4*x*(1-x) =
    (1/2-x) * (
      (1 * Real.sqrt 2 + ((-2125119/1600000:ℝ))) * 1 * z^0 * (1-z)^5 +
      ((17/15:ℝ) * Real.sqrt 2 + ((-3046931/2000000:ℝ))) * 5 * z^1 * (1-z)^4 +
      ((37/30:ℝ) * Real.sqrt 2 + ((-167447/100000:ℝ))) * 10 * z^2 * (1-z)^3 +
      ((13/10:ℝ) * Real.sqrt 2 + ((-17773/10000:ℝ))) * 10 * z^3 * (1-z)^2 +
      ((4/3:ℝ) * Real.sqrt 2 + ((-183463/100000:ℝ))) * 5 * z^4 * (1-z)^1 +
      ((4/3:ℝ) * Real.sqrt 2 + ((-22963/12500:ℝ))) * 1 * z^5 * (1-z)^0) := by
    dsimp [Q, R, z]
    ring
  have hp : 0 ≤ Q x + R (1-x) - 4*x*(1-x) := by
    rw [heq]
    positivity
  linarith

