    ((-5255232621031701 / 16384000000000 : ℝ) + (4061985027 / 16384000 : ℝ) * w) * t^8 * (1-t)^4 +
    ((-282802323187601 / 2048000000000 : ℝ) + (2247950867 / 20480000 : ℝ) * w) * t^9 * (1-t)^3 +
    ((-5206500291237037 / 131072000000000 : ℝ) + (13422983067 / 409600000 : ℝ) * w) * t^10 * (1-t)^2 +
    ((-17884834549625937 / 2621440000000000 : ℝ) + (242648391 / 40960000 : ℝ) * w) * t^11 * (1-t)^1 +
    ((-21987643061856089 / 41943040000000000 : ℝ) + (200842533 / 409600000 : ℝ) * w) * t^12 * (1-t)^0 := by unfold row12; ring
  rw [he]
  positivity
lemma normalized_certificate (s t : ℝ) (hs0 : 0 ≤ s) (hs1 : s ≤ 1)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    let x := (1-s/2)/2
    let y := (1+s/2+(1-s/2)*t)/2
    0 ≤ (y-x)^2 + (R y)^2 - (2*R ((x+y)/2)-Q x)^2 := by
  let w := Real.sqrt (2 : ℝ)
  have hw0 : 0 ≤ w := Real.sqrt_nonneg _
  have hw2 : w^2 = 2 := Real.sq_sqrt (by norm_num)
  have hwlo : (707/500 : ℝ) ≤ w := by nlinarith
  have hwhi : w ≤ (283/200 : ℝ) := by nlinarith
  have hs : 0 ≤ 1-s := by linarith
  have hr0 := row0_nonneg w t hwlo hwhi ht0 ht1
  have hr1 := row1_nonneg w t hwlo hwhi ht0 ht1
  have hr2 := row2_nonneg w t hwlo hwhi ht0 ht1
  have hr3 := row3_nonneg w t hwlo hwhi ht0 ht1
  have hr4 := row4_nonneg w t hwlo hwhi ht0 ht1
  have hr5 := row5_nonneg w t hwlo hwhi ht0 ht1
  have hr6 := row6_nonneg w t hwlo hwhi ht0 ht1
  have hr7 := row7_nonneg w t hwlo hwhi ht0 ht1
  have hr8 := row8_nonneg w t hwlo hwhi ht0 ht1
  have hr9 := row9_nonneg w t hwlo hwhi ht0 ht1
  have hr10 := row10_nonneg w t hwlo hwhi ht0 ht1
  have hr11 := row11_nonneg w t hwlo hwhi ht0 ht1
  have hr12 := row12_nonneg w t hwlo hwhi ht0 ht1
  have heq :
      (((1+s/2+(1-s/2)*t)/2)-((1-s/2)/2))^2 +
        (R ((1+s/2+(1-s/2)*t)/2))^2 -
        (2*R ((((1-s/2)/2)+((1+s/2+(1-s/2)*t)/2))/2)-Q ((1-s/2)/2))^2 =
    row0 w t * s^0 * (1-s)^12 +
    row1 w t * s^1 * (1-s)^11 +
    row2 w t * s^2 * (1-s)^10 +
    row3 w t * s^3 * (1-s)^9 +
    row4 w t * s^4 * (1-s)^8 +
    row5 w t * s^5 * (1-s)^7 +
    row6 w t * s^6 * (1-s)^6 +
    row7 w t * s^7 * (1-s)^5 +
    row8 w t * s^8 * (1-s)^4 +
    row9 w t * s^9 * (1-s)^3 +
    row10 w t * s^10 * (1-s)^2 +
    row11 w t * s^11 * (1-s)^1 +
    row12 w t * s^12 * (1-s)^0 := by
    dsimp [R,r,Q,w,row0,row1,row2,row3,row4,row5,row6,row7,row8,row9,row10,row11,row12]
    ring_nf
    norm_num [Real.sq_sqrt]
    ring
  dsimp only
  rw [heq]
  positivity

lemma QRR_squared (x y : ℝ) (hx : (1 : ℝ)/4 ≤ x) (hxhalf : x ≤ 1/2)
    (_hy : (1 : ℝ)/2 ≤ y) (hyone : y ≤ 1) (hmid : 1 ≤ x+y) :
    0 ≤ (y-x)^2 + (R y)^2 - (2*R ((x+y)/2)-Q x)^2 := by
  let s := 2-4*x
  let t := (x+y-1)/x
  have hxp : 0 < x := by linarith
  have hs0 : 0 ≤ s := by dsimp [s]; linarith
  have hs1 : s ≤ 1 := by dsimp [s]; linarith
  have ht0 : 0 ≤ t := div_nonneg (by linarith) hxp.le
  have ht1 : t ≤ 1 := (div_le_one hxp).mpr (by linarith)
  have h := normalized_certificate s t hs0 hs1 ht0 ht1
  have hex : (1-s/2)/2 = x := by dsimp [s]; ring
  have hey : (1+s/2+(1-s/2)*t)/2 = y := by
    dsimp [s,t]
    field_simp
    ring
  dsimp only at h
  simpa only [hex,hey] using h

lemma QRR_two_point (x y : ℝ) (hx : (1 : ℝ)/4 ≤ x) (hxhalf : x ≤ 1/2)
    (hy : (1 : ℝ)/2 ≤ y) (hyone : y ≤ 1) (hmid : 1 ≤ x+y) :
    2*R ((x+y)/2) ≤ Real.sqrt ((y-x)^2 + (R y)^2) + Q x := by
  have hd := QRR_squared x y hx hxhalf hy hyone hmid
  have hs : 2*R ((x+y)/2)-Q x ≤ Real.sqrt ((y-x)^2+(R y)^2) := by
    apply Real.le_sqrt_of_sq_le
    linarith
  linarith

end PolynomialQRR

