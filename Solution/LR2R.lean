theorem LR2R_leaf0 (u v : ℝ) (hu : u ∈ Set.Icc 0 1)
    (hv : v ∈ Set.Icc 0 1) :
    0 ≤ YLR2R u v-XLR2R u+(Real.sqrt 2-1)*R (YLR2R u v)+C2 (XLR2R u)-2*R ((XLR2R u+YLR2R u v)/2) := by
  have hs2 : (Real.sqrt (2 : ℝ))^2 = 2 := Real.sq_sqrt (by norm_num)
  have hs := Real.sqrt_nonneg (2 : ℝ)
  have hlo : 0 ≤ Real.sqrt (2:ℝ)-1414213/1000000 := by nlinarith
  have hhi : 0 ≤ 1414214/1000000-Real.sqrt (2:ℝ) := by nlinarith
  let U := (u-0)/1
  let V := (v-0)/1
  have hU : 0 ≤ U := by dsimp [U]; linarith [hu.1]
  have hU1 : 0 ≤ 1-U := by dsimp [U]; linarith [hu.2]
  have hV : 0 ≤ V := by dsimp [V]; linarith [hv.1]
  have hV1 : 0 ≤ 1-V := by dsimp [V]; linarith [hv.2]
  have hr0 := LR2R_0_row0_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr1 := LR2R_0_row1_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr2 := LR2R_0_row2_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr3 := LR2R_0_row3_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr4 := LR2R_0_row4_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr5 := LR2R_0_row5_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr6 := LR2R_0_row6_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have heq : YLR2R u v-XLR2R u+(Real.sqrt 2-1)*R (YLR2R u v)+C2 (XLR2R u)-2*R ((XLR2R u+YLR2R u v)/2) =
    LR2R_0_row0 (Real.sqrt 2) V * U^0 * (1-U)^6 +
    LR2R_0_row1 (Real.sqrt 2) V * U^1 * (1-U)^5 +
    LR2R_0_row2 (Real.sqrt 2) V * U^2 * (1-U)^4 +
    LR2R_0_row3 (Real.sqrt 2) V * U^3 * (1-U)^3 +
    LR2R_0_row4 (Real.sqrt 2) V * U^4 * (1-U)^2 +
    LR2R_0_row5 (Real.sqrt 2) V * U^5 * (1-U)^1 +
    LR2R_0_row6 (Real.sqrt 2) V * U^6 * (1-U)^0 := by
    dsimp [Q,R,C2,XLR2R,YLR2R,U,V,LR2R_0_row0,LR2R_0_row1,LR2R_0_row2,LR2R_0_row3,LR2R_0_row4,LR2R_0_row5,LR2R_0_row6]
    ring_nf <;> norm_num [hs2] <;> ring
  rw [heq] <;> positivity
end HammingCubeLR
