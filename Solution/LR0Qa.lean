theorem LR0Qa_leaf0 (u v : ℝ) (hu : u ∈ Set.Icc 0 1)
    (hv : v ∈ Set.Icc 0 1) :
    0 ≤ (YLR0Qa u v-XLR0Qa u)^2+(R (YLR0Qa u v))^2-(2*Q ((XLR0Qa u+YLR0Qa u v)/2)-C0 (XLR0Qa u))^2 := by
  have hs2 : (Real.sqrt (2 : ℝ))^2 = 2 := Real.sq_sqrt (by norm_num)
  have hs := Real.sqrt_nonneg (2 : ℝ)
  have hlo : 0 ≤ Real.sqrt (2:ℝ)-1414213/1000000 := by nlinarith
  have hhi : 0 ≤ 1414214/1000000-Real.sqrt (2:ℝ) := by nlinarith
  let U := (u-0)/1
  let V := (v-0)/1
  have hU : 0 ≤ U := by dsimp [U]; linarith [hu.1]
  have hU1 : 0 ≤ 1-U := by dsimp [U]; linarith [hu.2]
  have hV : 0 ≤ V := by dsimp [V]; linarith [hv.1]
  have hV1 : 0 ≤ 1-V := by dsimp [V]; linarith [hv.2]
  have hr0 := LR0Qa_0_row0_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr1 := LR0Qa_0_row1_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr2 := LR0Qa_0_row2_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr3 := LR0Qa_0_row3_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr4 := LR0Qa_0_row4_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr5 := LR0Qa_0_row5_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr6 := LR0Qa_0_row6_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr7 := LR0Qa_0_row7_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr8 := LR0Qa_0_row8_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr9 := LR0Qa_0_row9_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr10 := LR0Qa_0_row10_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr11 := LR0Qa_0_row11_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr12 := LR0Qa_0_row12_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have heq : (YLR0Qa u v-XLR0Qa u)^2+(R (YLR0Qa u v))^2-(2*Q ((XLR0Qa u+YLR0Qa u v)/2)-C0 (XLR0Qa u))^2 =
