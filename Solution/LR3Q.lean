theorem LR3Q_leaf2 (u v : ℝ) (hu : u ∈ Set.Icc 0 (1/2:ℝ))
    (hv : v ∈ Set.Icc (1/2:ℝ) 1) : 0 ≤ (YLR3Q u v-XLR3Q u)^2+(R (YLR3Q u v))^2-(2*Q ((XLR3Q u+YLR3Q u v)/2)-C3 (XLR3Q u))^2 := by
  have hs2 : (Real.sqrt (2:ℝ))^2 = 2 := Real.sq_sqrt (by norm_num)
  have hs := Real.sqrt_nonneg (2:ℝ)
  have hlo : 0 ≤ Real.sqrt (2:ℝ)-1414213/1000000 := by nlinarith
  have hhi : 0 ≤ 1414214/1000000-Real.sqrt (2:ℝ) := by nlinarith
  let U := (u-0)/(1/2:ℝ)
  let V := (v-(1/2:ℝ))/(1/2:ℝ)
  have hU : 0 ≤ U := by dsimp [U]; linarith [hu.1]
  have hU1 : 0 ≤ 1-U := by dsimp [U]; linarith [hu.2]
  have hV : 0 ≤ V := by dsimp [V]; linarith [hv.1]
  have hV1 : 0 ≤ 1-V := by dsimp [V]; linarith [hv.2]
  have hr0 := LR3Q_2_row0_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr1 := LR3Q_2_row1_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr2 := LR3Q_2_row2_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr3 := LR3Q_2_row3_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr4 := LR3Q_2_row4_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr5 := LR3Q_2_row5_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have hr6 := LR3Q_2_row6_nonneg (Real.sqrt 2) V hlo hhi hV hV1
  have heq : (YLR3Q u v-XLR3Q u)^2+(R (YLR3Q u v))^2-(2*Q ((XLR3Q u+YLR3Q u v)/2)-C3 (XLR3Q u))^2 =
    LR3Q_2_row0 (Real.sqrt 2) V*U^0*(1-U)^6 +
    LR3Q_2_row1 (Real.sqrt 2) V*U^1*(1-U)^5 +
    LR3Q_2_row2 (Real.sqrt 2) V*U^2*(1-U)^4 +
    LR3Q_2_row3 (Real.sqrt 2) V*U^3*(1-U)^3 +
    LR3Q_2_row4 (Real.sqrt 2) V*U^4*(1-U)^2 +
    LR3Q_2_row5 (Real.sqrt 2) V*U^5*(1-U)^1 +
    LR3Q_2_row6 (Real.sqrt 2) V*U^6*(1-U)^0 := by
